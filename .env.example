# Server
PORT=4311
NODE_ENV=development

# MongoDB Atlas connection string (free M0 cluster).
# Leave empty in local/dev to use the in-memory MongoDB fallback with sample seed data.
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/sanwra?retryWrites=true&w=majority
MONGODB_URI=

# Admin credentials (single-admin auth — no public user accounts)
ADMIN_EMAIL=admin@sanwratraders.com
ADMIN_PASSWORD=changeme-admin

# JWT signing secret — use a long random string in production
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Comma-separated origins for BOTH storefront + admin (Vercel)
# Local example:
# CORS_ORIGIN=http://127.0.0.1:4312,http://127.0.0.1:4313,http://localhost:4312,http://localhost:4313
# Production example:
# CORS_ORIGIN=https://sanwra-traders-4sp6.vercel.app,https://sanwra-traders-admin.vercel.app,https://sanwratraders.com
CORS_ORIGIN=http://127.0.0.1:4312,http://127.0.0.1:4313,http://localhost:4312,http://localhost:4313

# Optional Cloudinary (free tier). If unset, images are stored as local uploads or data URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sanwra-traders
